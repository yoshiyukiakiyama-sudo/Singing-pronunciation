{
  "title": "カンタータ 第147番　Jesus bleibet meine Freude",
  "artist": "J.S.BACH",
  "language": "ドイツ語",
  "lang_code": "de-DE",
  "generation_model": "gemini-3.8-flash",
  "lines": [
    {
      "original": "Jesus bleibet meine Freude,",
      "translation": "イエスは私の変わらぬ喜び、",
      "pronunciation": "イェーズス ブライベト マイネ フロイデ"
    },
    {
      "original": "Meines Herzens Trost und Saft,",
      "translation": "私の心の慰め、命の力。",
      "pronunciation": "マイネス ヘルツェンス トロースト ウント ザフト"
    },
    {
      "original": "Jesus wehret allem Leide,",
      "translation": "イエスはすべての苦難を防ぎ、",
      "pronunciation": "イェーズス ヴェーレト アレム ライデ"
    },
    {
      "original": "Er ist meines Lebens Kraft,",
      "translation": "主は私の命の力。",
      "pronunciation": "エーア イスト マイネス レーベンス クラフト"
    },
    {
      "original": "Meiner Augen Lust und Sonne,",
      "translation": "私の目の喜び、そして太陽、",
      "pronunciation": "マイナー アウゲン ルスト ウント ゾンネ"
    },
    {
      "original": "Meiner Seele Schatz und Wonne;",
      "translation": "私の魂の宝、そして歓喜。",
      "pronunciation": "マイナー ゼーレ シャッツ ウント ヴォンネ"
    },
    {
      "original": "Darum lass ich Jesum nicht",
      "translation": "だから私はイエスを手放さない、",
      "pronunciation": "ダールム ラス イッヒ イェーズム ニヒト"
    },
    {
      "original": "Aus dem Herzen und Gesicht.",
      "translation": "心からも、その御姿からも。",
      "pronunciation": "アウス デム ヘルツェン ウント ゲズィヒト"
    }
  ],
