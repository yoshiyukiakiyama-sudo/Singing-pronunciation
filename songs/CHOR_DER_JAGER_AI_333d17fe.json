{
  "title": "CHOR DER JÄGER (AI音声)",
  "artist": "von Weber / Kin",
  "language": "ドイツ語",
  "lang_code": "de-DE",
  "generation_model": "gemini-3.8-flash",
  "lines": [
    {
      "original": "Was gleicht wohl auf Erden dem Jägervergnügen,",
      "translation": "地上で狩人の喜びに匹敵するものがあろうか、",
      "pronunciation": "ヴァス グライヒト ヴォール アウフ エルデン デム イェーガーフェアグニューゲン"
    },
    {
      "original": "Wem sprudelt der Becher des Lebens so reich?",
      "translation": "誰のために生命の杯がこれほど豊かに湧き立つだろうか？",
      "pronunciation": "ヴェム シュプルーデルト デア ベッヒャー デス レーベンス ソー ライヒ"
    },
    {
      "original": "Beim Klange der Hörner im Grünen zu liegen,",
      "translation": "角笛の響きを聞きながら緑の中に横たわり、",
      "pronunciation": "バイム クランゲ デア ヘルナー イム グリューネン ツー リーゲン"
    },
    {
      "original": "Den Hirsch zu verfolgen durch Dickicht und Teich",
      "translation": "茂みや池を抜けて鹿を追うことは、",
      "pronunciation": "デン ヒルシュ ツー フェアフォルゲン ドゥルヒ ディッキヒト ウント タイヒ"
    },
    {
      "original": "Ist fürstliche Freude, ist männlich Verlangen,",
      "translation": "君侯の喜びであり、男らしい望みであり、",
      "pronunciation": "イスト フュルストリッヒェ フロイデ イスト メンリヒ フェアランゲン"
    },
    {
      "original": "Erstarket die Glieder und würzet das Mahl.",
      "translation": "手足を強め、食事の味を引き立てる。",
      "pronunciation": "エアシュタルケット ディー グリーダー ウント ヴュルツェト ダス マール"
    },
    {
      "original": "Wenn Wälder und Felsen uns hallend umfangen,",
      "translation": "森と岩山がこだまとなって我らを包むとき、",
      "pronunciation": "ヴェン ヴェルダー ウント フェルゼン ウンス ハレント ウムファンゲン"
    },
    {
      "original": "Tönt freier und freud'ger der volle Pokal!",
      "translation": "満ちた杯の音はより気兼ねなく、より喜ばしく響く！",
      "pronunciation": "テント フライアー ウント フロイトガー デア フォレ ポカール"
    },
    {
      "original": "Jo ho! Tralalalala!",
      "translation": "ヨーホー！トラララララ！",
      "pronunciation": "ヨー ホー トラララララ"
    },
    {
      "original": "Diana ist kundig, die Nacht zu erhellen,",
      "translation": "ディアナ（月の女神）は夜を明るく照らす心得があり、",
      "pronunciation": "ディアーナ イスト クンディヒ ディー ナハト ツー エアヘレン"
    },
    {
      "original": "Wie labend am Tage ihr Dunkel uns kühlt.",
      "translation": "昼にはその暗がりが我らをなんと爽やかに冷やしてくれることか。",
      "pronunciation": "ヴィー ラーベント アム ターゲ イーア ドゥンケル ウンス キュールト"
    },
    {
      "original": "Den blutigen Wolf und den Eber zu fällen,",
      "translation": "血に飢えた狼や猪を仕留めることは、",
      "pronunciation": "デン ブルーティゲン ヴォルフ ウント デン エーバー ツー フェレン"
    },
    {
      "original": "Der gierig die grünenden Saaten durchwühlt,",
      "translation": "（猪が）青々と茂る作物を貪欲に荒らし回るのを、",
      "pronunciation": "デア ギーリヒ ディー グリューネンデン ザーテン ドゥルヒヴュールト"
    },
    {
      "original": "Ist fürstliche Freude, ist männlich Verlangen,",
      "translation": "君侯の喜びであり、男らしい望みであり、",
      "pronunciation": "イスト フュルストリッヒェ フロイデ イスト メンリヒ フェアランゲン"
    },
    {
      "original": "Erstarket die Glieder und würzet das Mahl.",
      "translation": "手足を強め、食事の味を引き立てる。",
      "pronunciation": "エアシュタルケット ディー グリーダー ウント ヴュルツェト ダス マール"
    },
    {
      "original": "Wenn Wälder und Felsen uns hallend umfangen,",
      "translation": "森と岩山がこだまとなって我らを包むとき、",
      "pronunciation": "ヴェン ヴェルダー ウント フェルゼン ウンス ハレント ウムファンゲン"
    },
    {
      "original": "Tönt freier und freud'ger der volle Pokal!",
      "translation": "満ちた杯の音はより気兼ねなく、より喜ばしく響く！",
      "pronunciation": "テント フライアー ウント フロイトガー デア フォレ ポカール"
    },
    {
      "original": "Jo ho! Tralalalala!",
      "translation": "ヨーホー！トラララララ！",
      "pronunciation": "ヨー ホー トラララララ"
    }
  ],
