{
  "title": "Ave Maria",
  "artist": "",
  "language": "ラテン語",
  "lang_code": "la",
  "generation_model": "gemini-3.8-flash",
  "lines": [
    {
      "original": "Ave Maria, gratia plena,",
      "translation": "めでたしマリア、恵みに満ちた方、",
      "pronunciation": "アーヴェ マリア グラツィア プレーナ"
    },
    {
      "original": "Dominus tecum,",
      "translation": "主はあなたとともにおられます、",
      "pronunciation": "ドミヌス テークム"
    },
    {
      "original": "benedicta tu in mulieribus,",
      "translation": "あなたは女のうちで祝福され、",
      "pronunciation": "ベネディクタ トゥ イン ムリエリブス"
    },
    {
      "original": "et benedictus fructus ventris tui Jesus.",
      "translation": "あなたの胎内の実りであるイエスも祝福されています。",
      "pronunciation": "エト ベネディクトゥス フルクトゥス ヴェントリス トゥイ イエスス"
    },
    {
      "original": "Sancta Maria mater Dei,",
      "translation": "聖マリア、神の母よ、",
      "pronunciation": "サンクタ マリア マーテル デイ"
    },
    {
      "original": "ora pro nobis peccatoribus,",
      "translation": "わたしたち罪人のために祈ってください、",
      "pronunciation": "オーラ プロ ノービス ペッカトーリブス"
    },
    {
      "original": "nunc, et in hora mortis nostrae.",
      "translation": "今も、そしてわたしたちの死の時にも。",
      "pronunciation": "ヌンク エト イン ホーラ モルティス ノストレ"
    }
  ],
